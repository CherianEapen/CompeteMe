[
  {
    "id": "intune-whats-new",
    "vendor": "Microsoft Intune",
    "kind": "html-sections",
    "url": "https://learn.microsoft.com/en-us/intune/whats-new/",
    "container": "main",
    "sectionTag": "h2",
    "skipHeadings": "^(In this article|Feedback|Additional resources|Notices|See also|Related content|Next steps)",
    "maxSections": 6,
    "dateFromTitle": true,
    "mdChars": 12000,
    "note": "Weekly 'Week of …' sections. The newest section is also edited in place during the week, so changes matter here."
  },
  {
    "id": "intune-blog",
    "vendor": "Microsoft Intune",
    "kind": "rss",
    "url": "https://techcommunity.microsoft.com/t5/s/gxcuf89792/rss/board?board.id=MicrosoftIntuneBlog",
    "note": "RSS twin of https://techcommunity.microsoft.com/category/microsoftintune/blog/microsoftintuneblog (page itself is JS-rendered)."
  },
  {
    "id": "iru-updates",
    "vendor": "Iru",
    "kind": "rss",
    "url": "https://www.iru.com/updates/rss.xml",
    "note": "RSS twin of https://www.iru.com/updates."
  },
  {
    "id": "hexnode-whats-new",
    "vendor": "Hexnode",
    "kind": "next-data",
    "url": "https://www.hexnode.com/whats-new/",
    "matchKeys": ["badge", "devices", "release_date"],
    "fields": { "title": "title", "date": "release_date", "url": "button_link", "text": "description" },
    "note": "Page is Next.js; items are embedded in __NEXT_DATA__."
  },
  {
    "id": "hexnode-blog",
    "vendor": "Hexnode",
    "kind": "rss",
    "url": "https://www.hexnode.com/blogs/feed/",
    "include": "windows|new feature|now available|introduc|releas|launch|update|announce|hexnode uem|product",
    "includeFields": ["title", "categories"],
    "note": "Marketing-heavy; filtered to product/feature posts by title and category."
  },
  {
    "id": "miradore-releases",
    "vendor": "Miradore",
    "kind": "link-list",
    "url": "https://www.miradore.com/knowledge/releases/",
    "linkPattern": "^https://www\\.miradore\\.com/knowledge/releases/[^/]+/$",
    "fetchNew": true,
    "maxFetch": 5,
    "baselineUndatedMax": 5,
    "note": "Each release has its own page. Older slugs are dates (dd-mm-yyyy), newer ones are descriptive, so a new link is the signal and the date is read from the page."
  },
  {
    "id": "42gears-press",
    "vendor": "42Gears",
    "kind": "link-list",
    "url": "https://www.42gears.com/press-releases",
    "linkPattern": "^/press-releases/[^/]+/$",
    "fetchNew": true,
    "maxFetch": 6,
    "baselineUndatedMax": 6
  },
  {
    "id": "42gears-docs",
    "vendor": "42Gears",
    "kind": "sitemap",
    "url": "https://docs.42gears.com/suremdm/sitemap.xml",
    "fetchInclude": "windows|win32|msi|kiosk|patch|bitlocker|autopilot|enroll|update",
    "reportInclude": "windows|win32|msi|bitlocker|autopilot",
    "maxFetch": 25,
    "note": "SureMDM has no release-notes page; new or updated doc pages (sitemap lastmod) are the release signal. Report lists Windows-related pages only."
  },
  {
    "id": "jamf-pro-release-notes",
    "vendor": "Jamf",
    "kind": "jamf-khub",
    "base": "https://learn.jamf.com",
    "mapTitlePattern": "^Jamf Pro Release Notes (\\d+(?:\\.\\d+)*)$",
    "sections": ["New Features and Enhancements", "Important Notices", "Deprecations and Removals", "Resolved Issues"],
    "baselineUndatedMax": 100,
    "note": "Fluid Topics REST API behind https://learn.jamf.com/r/en-US/jamf-pro-release-notes-current/…; a new version shows up as a new map."
  },
  {
    "id": "scalefusion-release-notes",
    "vendor": "Scalefusion",
    "kind": "d360-index",
    "urlTemplate": "https://help.scalefusion.com/docs/latest-release-notes-year-{year}",
    "note": "Document360 renders the article body client-side; the SSR state carries the release index (version, date, headline). Year in URL resolves automatically."
  },
  {
    "id": "scalefusion-product-updates",
    "vendor": "Scalefusion",
    "kind": "rss",
    "url": "https://blog.scalefusion.com/category/product-updates/feed/",
    "note": "Product-updates blog category; complements the release-notes index."
  },
  {
    "id": "ivanti-quarterly-releases",
    "vendor": "Ivanti",
    "kind": "html-blocks",
    "hub": { "url": "https://www.ivanti.com/releases", "linkPattern": "^https://www\\.ivanti\\.com/releases/\\d{4}/q\\d$", "latest": 2 },
    "titleSelector": ".accordion-toggle",
    "contentSelector": ".accordion-content",
    "baselineUndatedMax": 60,
    "note": "Hub links to per-quarter pages; each product is an accordion. Latest two quarters tracked."
  },
  {
    "id": "manageengine-release-notes",
    "vendor": "ManageEngine",
    "kind": "html-sections",
    "url": "TBD",
    "enabled": false,
    "note": "Awaiting product choice: Mobile Device Manager Plus vs Endpoint Central. The URL supplied (Applications Manager) is an APM product."
  }
]
